# Clerk — required at dev/test time
# Get these from https://dashboard.clerk.com (use a "Test" instance for development)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Optional: enable Clerk's debug logger
# EXPO_PUBLIC_CLERK_DEBUG=1

# Sentry — optional for local dev; required on EAS Build / production
# Leaving EXPO_PUBLIC_SENTRY_DSN unset makes Sentry init a no-op.
# EXPO_PUBLIC_SENTRY_DSN=https://<key>@<orgId>.ingest.sentry.io/<projectId>
# EXPO_PUBLIC_SENTRY_ENV=development  # override; otherwise derived from __DEV__

# PostHog — optional for local dev; required to capture product events
# Leaving EXPO_PUBLIC_POSTHOG_KEY unset makes analytics a no-op (events are dropped).
# EXPO_PUBLIC_POSTHOG_KEY=phc_replace_me
# EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Backend (API) ────────────────────────────────────────────────────────────
# These are server-side only; never prefix with EXPO_PUBLIC_.

# Neon Postgres connection string. Get from https://console.neon.tech → project → connection string.
DATABASE_URL=postgres://user:pass@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Clerk backend secret key (server-side). Get from https://dashboard.clerk.com → API Keys.
CLERK_SECRET_KEY=sk_test_replace_me

# Clerk publishable key (server-side mirror of EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY).
# Used by the API to verify JWTs when EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY is not in scope.
CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Optional: override the base URL the mobile client uses to reach the API.
# Defaults to http://localhost:8081 in local dev; set to a preview URL for integration testing.
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8081

# Optional: comma-separated list of allowed `azp` (Authorized Party) values for Clerk JWT
# validation.  When unset, any azp is accepted (single-tenant / dev default).  Set this in
# production to the exact origin(s) your app is served from.
# CLERK_ALLOWED_AZP=https://app.example.com,https://app.example.dev

# ── Stripe ───────────────────────────────────────────────────────────────────
# Stripe secret key. Use a sandbox (test mode) key for local development.
# Get from https://dashboard.stripe.com → Developers → API keys.
STRIPE_SECRET_KEY=sk_test_replace_me

# Stripe webhook signing secret for verifying incoming webhook payloads.
# Get from https://dashboard.stripe.com → Developers → Webhooks → your endpoint → Signing secret.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Public base URL of the app, used to construct Stripe Account Link return/refresh URLs.
# In local dev, typically http://localhost:8081; in production, your deployed domain.
EXPO_PUBLIC_APP_URL=http://localhost:8081

# ── Catalog (S-1.4) ──────────────────────────────────────────────────────────
# TTL for the Postgres-backed catalog_search_cache (days). Default 30.
# CATALOG_CACHE_TTL_DAYS=30

# ── Cloudflare R2 + Images (S-1.3) ───────────────────────────────────────────
# All of these are server-side only; never prefix with EXPO_PUBLIC_.
# Set them in Cloudflare Pages via: wrangler pages secret put <VAR> --project-name slabd-web

# Your Cloudflare account ID. Get from https://dash.cloudflare.com → right sidebar.
CF_ACCOUNT_ID=replace_me

# R2 API credentials. Create an API token at https://dash.cloudflare.com → R2 → Manage R2 API Tokens
# with "Object Read & Write" permissions scoped to your bucket.
CF_R2_ACCESS_KEY_ID=replace_me
CF_R2_SECRET_ACCESS_KEY=replace_me

# The name of your R2 bucket (e.g. "sleeve-images-dev").
# Get from https://dash.cloudflare.com → R2 → your bucket name.
CF_R2_BUCKET=replace_me

# Cloudflare Images account hash — used to construct public variant URLs.
# Get from https://dash.cloudflare.com → Images → Overview (shown as "Account Hash").
# Not technically a secret but tracked here for config hygiene (no EXPO_PUBLIC_ prefix needed).
CF_IMAGES_ACCOUNT_HASH=replace_me
