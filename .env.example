# Clerk — required at dev/test time
# Get these from https://dashboard.clerk.com (use a "Test" instance for development)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Optional: enable Clerk's debug logger
# EXPO_PUBLIC_CLERK_DEBUG=1

# Sentry — optional for local dev; required on EAS Build / production
# Leaving EXPO_PUBLIC_SENTRY_DSN unset makes Sentry init a no-op.
# EXPO_PUBLIC_SENTRY_DSN=https://<key>@<orgId>.ingest.sentry.io/<projectId>
# EXPO_PUBLIC_SENTRY_ENV=development  # override; otherwise derived from __DEV__

# PostHog — optional for local dev; required to capture product events
# Leaving EXPO_PUBLIC_POSTHOG_KEY unset makes analytics a no-op (events are dropped).
# EXPO_PUBLIC_POSTHOG_KEY=phc_replace_me
# EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Backend (API) ────────────────────────────────────────────────────────────
# These are server-side only; never prefix with EXPO_PUBLIC_.

# Neon Postgres connection string. Get from https://console.neon.tech → project → connection string.
DATABASE_URL=postgres://user:pass@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Clerk backend secret key (server-side). Get from https://dashboard.clerk.com → API Keys.
CLERK_SECRET_KEY=sk_test_replace_me

# Clerk publishable key (server-side mirror of EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY).
# Used by the API to verify JWTs when EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY is not in scope.
CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Optional: override the base URL the mobile client uses to reach the API.
# Defaults to http://localhost:8081 in local dev; set to a preview URL for integration testing.
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8081

# Optional: comma-separated list of allowed `azp` (Authorized Party) values for Clerk JWT
# validation.  When unset, any azp is accepted (single-tenant / dev default).  Set this in
# production to the exact origin(s) your app is served from.
# CLERK_ALLOWED_AZP=https://app.example.com,https://app.example.dev
