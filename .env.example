# Clerk — required at dev/test time
# Get these from https://dashboard.clerk.com (use a "Test" instance for development)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Optional: enable Clerk's debug logger
# EXPO_PUBLIC_CLERK_DEBUG=1

# Sentry — optional for local dev; required on EAS Build / production
# Leaving EXPO_PUBLIC_SENTRY_DSN unset makes Sentry init a no-op.
# EXPO_PUBLIC_SENTRY_DSN=https://<key>@<orgId>.ingest.sentry.io/<projectId>
# EXPO_PUBLIC_SENTRY_ENV=development  # override; otherwise derived from __DEV__
